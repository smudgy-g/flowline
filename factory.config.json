{
  "repo": "ColoniaTech/colonia_client",
  "base": "staging",
  "workspace": "..",
  "checkout": "client/staging",
  "worktrees": "client/worktrees",
  "readable": ["supabase/staging"],
  "uat": {
    "assets": ".cache/uat-assets",
    "inputs": ["scripts/run-uat.sh", "scripts/uat-app.sh", "scripts/uat-browser.sh", "scripts/local-dns.cjs", "scripts/mock-dns.mjs", "scripts/fake-resend.mjs", "scripts/summarize.mjs", "specs", "seeds", "playwright.config.mjs", "lighthouse-baseline.json"],
    "command": ["bash", "scripts/run-uat.sh"],
    "env": {"APP_IMAGE":"factory-project:local", "RUNNER_IMAGE":"factory-browser:local"}
  },
  "commands": {
    "preview": ["bash", "/opt/factory/scripts/project-preview.sh"],
    "changedCode": ["**/*.{js,ts,jsx,tsx,mjs,cjs,mts,cts,vue}"],
    "setup": [["pnpm", "install", "--frozen-lockfile"], ["pnpm", "exec", "nuxt", "prepare"]],
    "autofix": [["pnpm", "exec", "eslint", "--fix", "--no-warn-ignored", "--", "{changedCode}"], ["pnpm", "exec", "prettier", "--write", "--ignore-unknown", "--", "{changedCode}"]],
    "check": [["pnpm", "lint"], ["pnpm", "typecheck"]],
    "gates": [["pnpm", "test"], ["pnpm", "test:ssr"]],
    "env": {"CI":"true", "NUXT_TELEMETRY_DISABLED":"1", "NUXT_PUBLIC_SUPABASE_URL":"http://127.0.0.1:54321", "NUXT_PUBLIC_SUPABASE_KEY":"test-key", "STUDIO_GITHUB_TOKEN":"test-token"}
  },
  "sandbox": {
    "kit": "shell",
    "cpus": 2,
    "memory": "2g",
    "allowlist": ["registry.npmjs.org"],
    "maxConcurrent": 1
  },
  "skills": {
    "packs": ["skills/core", "skills/typescript", "skills/nuxt"],
    "coder": {
      "always": ["ponytail", "write-tests"],
      "areas": {
        "components": {
          "paths": ["components/**", "app/components/**"],
          "skills": ["write-component"]
        },
        "composables": {
          "paths": ["composables/**", "app/composables/**"],
          "skills": ["write-composable"]
        },
        "server routes": {
          "paths": ["server/api/**"],
          "skills": ["write-server-route"]
        }
      }
    },
    "codeReviewers": ["architect", "interrogate", "change-impact", "typescript-guidance"]
  }
}
