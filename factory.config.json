{
  "repo": "example/project",
  "base": "main",
  "workspace": "..",
  "checkout": "project/main",
  "worktrees": "project/worktrees",
  "paths": {
    "tests": [
      "tests/**"
    ],
    "protected": [
      ".factory/**"
    ],
    "sensitive": []
  },
  "sandbox": {
    "kit": "shell",
    "cpus": 2,
    "memory": "2g",
    "allowlist": [],
    "maxConcurrent": 1
  },
  "tracker": {
    "command": [
      "node",
      "trackers/local.mjs"
    ],
    "env": {}
  },
  "commands": {
    "changedCode": [
      "**/*"
    ],
    "setup": [],
    "autofix": [],
    "check": [],
    "gates": [
      [
        "make",
        "test"
      ]
    ],
    "env": {
      "CI": "true"
    }
  },
  "acceptance": {
    "inputs": [
      "acceptance"
    ],
    "command": [
      "bash",
      "acceptance/run.sh"
    ],
    "env": {}
  },
  "skills": {
    "packs": [
      "skills/core"
    ],
    "coder": {
      "always": [
        "ponytail"
      ]
    },
    "codeReviewers": [
      "architect",
      "interrogate",
      "change-impact"
    ]
  }
}
