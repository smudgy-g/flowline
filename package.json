{
  "name": "frankenstein-factory",
  "version": "0.1.0",
  "description": "A software factory: a work item goes in, a reviewed, acceptance-tested change comes out.",
  "type": "module",
  "bin": {
    "frankenstein": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "trackers",
    "templates",
    "docs",
    "README.md",
    "WORKFLOW.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/board.html dist/board.html",
    "prepack": "npm run build",
    "test": "node --test 'test/*.test.ts' && node --test scripts/*.test.mjs",
    "check": "tsc -p tsconfig.check.json && node --test 'test/*.test.ts' && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@mastra/core": "1.83.0",
    "@mastra/libsql": "1.30.0",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.22.0"
}
